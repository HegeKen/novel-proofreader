{
  "name": "proofreader",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:signing": "node scripts/setup-signing.mjs",
    "signing:check": "node scripts/signing-check.mjs",
    "signing:apply": "node scripts/signing-check.mjs --apply",
    "build:release": "node scripts/build-release.mjs",
    "artifact:manifest": "node scripts/artifact-manifest.mjs generate",
    "artifact:merge": "node scripts/artifact-manifest.mjs merge",
    "verify:reproducible": "node scripts/verify-artifacts.mjs reproducible",
    "verify:signed": "node scripts/verify-artifacts.mjs signed",
    "android:normalize": "node scripts/verify-artifacts.mjs apk --normalize",
    "rename:android": "node scripts/rename-android-artifacts.mjs",
    "secrets:status": "node scripts/secrets-status.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "chinese-conv": "^4.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
